# Google Apps Script Web App URL that receives RSVP POSTs. When unset, the
# /api/rsvp route acknowledges locally instead of failing guests (dev fallback).
GOOGLE_SHEETS_WEBHOOK_URL=

# Absolute base URL of the deployed site — used to resolve OG/Twitter image
# URLs and to silence the "metadataBase is not set" build warning.
NEXT_PUBLIC_SITE_URL=https://your-domain.example